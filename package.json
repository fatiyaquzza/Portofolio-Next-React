{
  "name": "portfolio-react-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/content.test.mjs tests/contact.test.mjs tests/contact-email.test.mjs tests/rate-limit.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "migrate:projects": "node scripts/migrate-project-metadata.mjs",
    "migrate:projects:apply": "node scripts/migrate-project-metadata.mjs --apply",
    "check": "npm run lint && npm run typecheck && npm test",
    "smoke": "node scripts/browser-smoke.mjs",
    "test:themes": "node scripts/theme-smoke.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.6.1",
    "@react-three/fiber": "^9.3.0",
    "@react-three/rapier": "^2.1.0",
    "@tabler/icons-react": "^3.34.1",
    "aos": "^2.3.4",
    "clsx": "^2.1.1",
    "firebase": "^12.1.0",
    "firebase-admin": "^14.0.0",
    "framer-motion": "^12.23.11",
    "gsap": "^3.13.0",
    "lucide-react": "^0.533.0",
    "meshline": "^3.3.1",
    "motion": "^12.23.11",
    "next": "15.5.24",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.0",
    "ogl": "^1.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.167.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "firebase-tools": "^15.29.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  }
